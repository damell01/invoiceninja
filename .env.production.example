APP_NAME="Bellflow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false

APP_URL=https://bellflow.example.com
REACT_URL=https://bellflow.example.com

BRAND_COMPANY_NAME="Bellflow"
BRAND_SUPPORT_EMAIL="support@bellflow.example.com"
BRAND_SUPPORT_NAME="Bellflow"
BRAND_WEBSITE_URL="https://bellflow.example.com"
BRAND_SUPPORT_URL="https://bellflow.example.com/support"
BRAND_TERMS_URL="https://bellflow.example.com/terms"
BRAND_PRIVACY_URL="https://bellflow.example.com/privacy"
BRAND_BROWSER_TITLE="Bellflow"
BRAND_FOOTER_LINK_TEXT="Bellflow"
BRAND_FOOTER_TEXT="Powered by Bellflow"
BRAND_LOGO_LIGHT="images/bellflow-logo.svg"
BRAND_LOGO_DARK="images/bellflow-logo.svg"
BRAND_APP_LOGO="https://bellflow.example.com/images/bellflow-logo.svg"
BRAND_FAVICON="images/bellflow-favicon.svg"

DB_CONNECTION=mysql
MULTI_DB_ENABLED=false
DB_HOST=127.0.0.1
DB_DATABASE=bellflow
DB_USERNAME=bellflow
DB_PASSWORD=change-me
DB_PORT=3306

DEMO_MODE=false
REQUIRE_HTTPS=true
TRUSTED_PROXIES=*

BROADCAST_DRIVER=log
LOG_CHANNEL=stack
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="support@bellflow.example.com"
MAIL_FROM_NAME="Bellflow"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

POSTMARK_API_TOKEN=
ERROR_EMAIL=

NINJA_ENVIRONMENT=selfhost

AI_ENABLED=true
AI_PROVIDER=qwen
AI_BASE_URL=http://127.0.0.1:8000
AI_CHAT_ENDPOINT=/v1/chat/completions
AI_HEALTH_ENDPOINT=/v1/models
AI_API_KEY=
AI_MODEL=qwen
AI_TIMEOUT=120
AI_CONNECT_TIMEOUT=10
AI_QUEUE=default
AI_SYSTEM_PROMPT="You are Bellflow AI. Help draft, summarize, and improve contracts with concise, business-safe output."

CONTRACTS_AI_ENABLED=true
CONTRACTS_AI_QUEUE=default
CONTRACTS_AI_DEFAULT_ACTION=summarize
CONTRACTS_PAYMENT_PROCESSOR=invoice_ninja_gateways
CONTRACTS_CHECKOUT_SURFACE=invoice_ninja_portal
CONTRACTS_GENERATE_INVOICE_ON_SIGN=true
CONTRACTS_UI_ENABLED=true
CONTRACTS_ADMIN_ENABLED=true
CONTRACTS_PORTAL_ENABLED=true
CONTRACTS_PORTAL_MENU_ENABLED=true
CONTRACTS_PUBLIC_SIGN_ENABLED=true

BELLFLOW_MODULE_VISIBILITY_MODE=allow_all
BELLFLOW_ALLOWED_MODULES=contracts
BELLFLOW_HIDDEN_MODULES=
BELLFLOW_HIDDEN_PORTAL_ITEMS=

PDF_GENERATOR=hosted_ninja
PHANTOMJS_KEY='a-demo-key-with-low-quota-per-ip-address'
PHANTOMJS_SECRET=secret

UPDATE_SECRET=secret
DELETE_PDF_DAYS=60
DELETE_BACKUP_DAYS=60

# Payment gateway credentials are usually configured in the Bellflow / Invoice Ninja UI,
# not here. After install, log in and configure Stripe or other gateways in settings.
